DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
# Comma-separated list of origins allowed to call the API.
# For local dev add http://localhost:5173 (Vite default).
ALLOWED_ORIGINS=https://bikegrid.com.au,https://www.bikegrid.com.au,http://localhost:5173
# Impact affiliate tracking URL for Bikes Online. Omit or leave blank to disable.
IMPACT_BIKESONLINE_URL=https://bikesonline-australia.pxf.io/c/XXXXXXX/XXXXXXX/XXXXX

# --- Self-hosted deployment (docker compose) -------------------------------
# Only needed on the VPS. DATABASE_URL is composed from these in
# docker-compose.yml, so do not set DATABASE_URL in .env on the server.
POSTGRES_USER=bikegrid
POSTGRES_DB=bikegrid
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Domain Caddy requests a TLS certificate for. Must already resolve here.
API_DOMAIN=api.bikegrid.com.au
# Interface Postgres binds to. Loopback until Tailscale is running, then the
# tailnet IP (100.x.y.z) so GitHub Actions can reach it privately.
DB_BIND_IP=127.0.0.1
