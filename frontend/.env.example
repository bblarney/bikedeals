# Base URL of the BikeGrid API (no trailing slash).
# Local dev with the API on the same origin can leave this blank to use
# relative /api/v1 paths. For production (Cloudflare Pages) this MUST be set to
# the deployed API origin, e.g. https://api.bikegrid.com.au, and must match the
# connect-src in public/_headers.
VITE_API_BASE_URL=https://api.bikegrid.com.au
