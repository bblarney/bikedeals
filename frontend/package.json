{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:ssr && node scripts/prerender.js",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:pages": "wrangler pages dev dist --port 8788 --compatibility-date=2026-05-01",
    "test": "node --test test/bike-detail-function.test.js test/market-transforms.test.js test/filter-chips.test.js test/time-labels.test.js test/model-name.test.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wrangler": "^4.86.0"
  }
}
